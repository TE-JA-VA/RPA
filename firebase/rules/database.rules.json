{
  "rules": {
    ".read": false,
    ".write": false,

    "meta": {
      "companies": {
        "$cid": {
          ".read": "auth != null && ((auth.token.cid === $cid && auth.token.role !== 'phone') || auth.token.role === 'super')",
          ".write": "auth != null && auth.token.role === 'super'"
        }
      }
    },

    "apps": {
      "rpa": {
        "live": {
          "$cid": {
            "$pcId": {
              ".read": "auth != null && ((auth.token.cid === $cid && auth.token.role !== 'phone') || auth.token.role === 'super')",
              ".write": "auth != null && auth.token.role === 'agent' && auth.token.cid === $cid && auth.token.pcId === $pcId"
            }
          }
        },

        "settings": {
          "$cid": {
            "$pcId": {
              ".read": "auth != null && ((auth.token.cid === $cid && auth.token.role !== 'phone') || auth.token.role === 'super')",
              ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.cid === $cid) || auth.token.role === 'super')"
            }
          }
        },

        "commands": {
          "$cid": {
            "$pcId": {
              ".read": "auth != null && ((auth.token.cid === $cid && auth.token.role !== 'phone') || auth.token.role === 'super')",
              ".indexOn": ["state"],

              "$cmdId": {
                ".write": "auth != null && ((!data.exists() && newData.exists() && ((auth.token.role === 'admin' && auth.token.cid === $cid) || auth.token.role === 'super')) || (data.exists() && auth.token.role === 'agent' && auth.token.cid === $cid && auth.token.pcId === $pcId))",
                ".validate": "newData.hasChildren(['type', 'by', 'created_at', 'expires_at', 'state'])",

                "type": {
                  ".validate": "newData.isString() && (newData.val() === 'launch' || newData.val() === 'stop_erpia' || newData.val() === 'stop_rpa' ||newData.val() === 'set_modules' || newData.val() === 'set_schedule' || newData.val() === 'set_presets' || newData.val() === 'set_parallel' || newData.val() === 'set_together' || newData.val() === 'resume_repeat' || newData.val() === 'export_preset' || newData.val() === 'import_preset' || newData.val() === 'restore_preset') && (!data.exists() || data.val() === newData.val())"
                },
                "by": {
                  ".validate": "newData.isString() && (data.exists() ? data.val() === newData.val() : newData.val() === auth.uid)"
                },
                "created_at": {
                  ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
                },
                "expires_at": {
                  ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
                },
                "state": {
                  ".validate": "newData.isString() && (!data.exists() ? newData.val() === 'queued' : (auth.token.role === 'agent' && ((data.val() === 'queued' && (newData.val() === 'running' || newData.val() === 'expired')) || (data.val() === 'running' && (newData.val() === 'done' || newData.val() === 'failed')))))"
                },
                "args": { ".validate": "!data.exists() || data.val() === newData.val()" },
                "result": { ".validate": "newData.isString() && auth.token.role === 'agent'" },
                "started_at": { ".validate": "newData.isNumber() && auth.token.role === 'agent'" },
                "ended_at": { ".validate": "newData.isNumber() && auth.token.role === 'agent'" },
                "$other": { ".validate": false }
              }
            }
          }
        },

        "transfers": {
          "$cid": {
            ".read": "auth != null && ((auth.token.role === 'agent' && auth.token.cid === $cid) || auth.token.role === 'super')",

            "$tid": {
              ".write": "auth != null && (auth.token.role === 'super' || (auth.token.role === 'agent' && auth.token.cid === $cid && (!newData.exists() || (!data.exists() && newData.child('from_pc').val() === auth.token.pcId))))",
              ".validate": "$tid.matches(/^[A-Za-z0-9_-]{16,40}$/) && newData.hasChildren(['from_pc', 'by', 'created_at', 'expires_at']) && (newData.hasChild('presets') || newData.hasChild('failed'))",
              "from_pc": { ".validate": "newData.isString()" },
              "by": { ".validate": "newData.isString()" },
              "created_at": { ".validate": "newData.isNumber() && newData.val() >= now - 600000 && newData.val() <= now + 600000" },
              "expires_at": { ".validate": "newData.isNumber() && newData.val() <= newData.parent().child('created_at').val() + 21600000" },
              "presets": { ".validate": "newData.hasChildren()" },
              "failed": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "$other": { ".validate": false }
            }
          }
        }
      },

      "otp": {
        "requests": {
          "$cid": {
            "$phoneId": {
              "current": {
                ".read": "auth != null && ((auth.token.cid === $cid && (auth.token.role !== 'phone' || auth.token.phoneId === $phoneId)) || auth.token.role === 'super')",
                ".write": "auth != null && auth.token.role === 'agent' && auth.token.cid === $cid && (!data.exists() || data.child('pcId').val() === auth.token.pcId || data.child('created_at').val() + 120000 < now)",
                ".validate": "newData.hasChildren(['req_id', 'site', 'senders', 'pcId', 'created_at'])",
                "req_id": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{8,64}$/)" },
                "site": { ".validate": "newData.isString() && newData.val().length <= 100" },
                "senders": {
                  ".validate": "newData.hasChildren()",
                  "$num": { ".validate": "$num.matches(/^[0-9]{3,15}$/) && newData.val() === true" }
                },
                "pcId": { ".validate": "newData.val() === auth.token.pcId" },
                "created_at": { ".validate": "newData.val() === now" },
                "$other": { ".validate": false }
              }
            }
          }
        },

        "codes": {
          "$cid": {
            "$phoneId": {
              "current": {
                ".read": "auth != null && auth.token.role === 'agent' && auth.token.cid === $cid && root.child('apps/otp/requests/' + $cid + '/' + $phoneId + '/current/pcId').val() === auth.token.pcId",
                ".write": "auth != null && ((auth.token.role === 'agent' && auth.token.cid === $cid && !newData.exists()) || (auth.token.role === 'phone' && auth.token.cid === $cid && auth.token.phoneId === $phoneId && root.child('apps/otp/requests/' + $cid + '/' + $phoneId + '/current/created_at').val() + 120000 > now))",
                ".validate": "newData.hasChildren(['req_id', 'code', 'sender', 'sms_at', 'written_at']) && newData.child('req_id').val() === root.child('apps/otp/requests/' + $cid + '/' + $phoneId + '/current/req_id').val() && root.child('apps/otp/requests/' + $cid + '/' + $phoneId + '/current/senders/' + newData.child('sender').val()).val() === true",
                "req_id": { ".validate": "newData.isString()" },
                "code": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,8}$/)" },
                "sender": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{3,15}$/)" },
                "sms_at": { ".validate": "newData.isNumber()" },
                "written_at": { ".validate": "newData.val() === now" },
                "$other": { ".validate": false }
              }
            }
          }
        },

        "phones": {
          "$cid": {
            "$phoneId": {
              ".read": "auth != null && ((auth.token.cid === $cid && auth.token.role !== 'phone') || auth.token.role === 'super')",
              ".write": "auth != null && auth.token.role === 'phone' && auth.token.cid === $cid && auth.token.phoneId === $phoneId",
              ".validate": "newData.hasChildren(['os', 'app_version', 'last_seen'])",
              "os": { ".validate": "newData.val() === 'android' || newData.val() === 'ios'" },
              "app_version": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "last_seen": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
