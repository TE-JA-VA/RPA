# 오토파일럿 사내 서버 (설치: install.sh - 이 파일을 /etc/systemd/system/ 에 넣고 @ALLOW@ 를 server.json 의 allow 로 채운다)
# 종료 코드: 0 정상, 2 라이선스, 3 포트를 못 엶, 4 설정·자료가 깨짐 - 2·4 는 다시 켜도 같으므로 다시 켜지 않는다.
# SIGUSR1 은 '지금 백업' (autopilot-server backup) 이라 ExecReload 로 쓰지 않는다.
[Unit]
Description=AUTOPILOT server (web 8443, agent 8444)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autopilotd
ExecStart=/usr/local/sbin/autopilot-server run
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 4
TimeoutStopSec=30
UMask=0077

# 보호 설정 - 서비스 계정은 자료·기록 폴더 말고는 쓸 수 없고 프로그램 폴더(/opt/autopilot)는 읽기만
ProtectSystem=strict
ReadWritePaths=/var/lib/autopilot /var/log/autopilot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 사내 대역 밖으로 패킷을 주고받지 못하게 (이름 localhost 대신 주소를 적는다 - 127.0.0.53 DNS 가 열리지 않게)
IPAddressDeny=any
IPAddressAllow=@ALLOW@ 127.0.0.1/32 ::1/128

[Install]
WantedBy=multi-user.target
